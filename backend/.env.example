# Copy to .env and adjust. Never commit the real .env.

# App
ENVIRONMENT=development
DEBUG=true

# Database (docker-compose service name is "db")
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shopdb

# Auth / JWT
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI service (Member 4's FastAPI microservice)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=30

# Internal API key for /internal/* endpoints (catalog export for the AI indexer)
INTERNAL_API_KEY=change-me-internal-key

# Google Maps (leave empty to use the mock location resolver)
GOOGLE_MAPS_API_KEY=

# Delivery configuration
DELIVERY_ZONE_CITIES=Amman
DEFAULT_DELIVERY_FEE=3.0
DEFAULT_CURRENCY=JOD

# CORS (frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:3000
