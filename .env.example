# =============================================================================
# AI Shopping Assistant — Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Never commit .env to Git.
# =============================================================================

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopdb
POSTGRES_HOST_PORT=5433

# ----- Backend (FastAPI) -----
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/shopdb
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_KEY=change-me-internal-key
GOOGLE_MAPS_API_KEY=
DELIVERY_ZONE_CITIES=Amman
DEFAULT_DELIVERY_FEE=3.0
DEFAULT_CURRENCY=JOD
CORS_ORIGINS=http://localhost:3000,http://localhost:80
BACKEND_HOST_PORT=8000

# ----- AI Service (Agentic-RAG) -----
GROQ_API_KEY=your-groq-api-key-here
XAI_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
AI_SERVICE_HOST_PORT=8001

# ----- AI Service URL (used by backend to call AI service) -----
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_SECONDS=30

# ----- OpenAI (Admin NLP-to-SQL + Whisper voice input) -----
OPENAI_API_KEY=your-openai-api-key-here

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_API_MOCKS=false
FRONTEND_HOST_PORT=3000

# ----- Nginx -----
NGINX_HOST_PORT=80
